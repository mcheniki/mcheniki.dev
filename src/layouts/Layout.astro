---
import '../styles/fonts.css';
import '../styles/global.css';

import { getRelativeLocaleUrl } from 'astro:i18n';
import { getEntry } from 'astro:content';

import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { localeMetadata, locales, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

type Props = {
	locale: Locale;
	title: string;
	description: string;
	image?: string;
	imageAlt?: string;
	isProfilePage?: boolean;
	// fallow-ignore-next-line unused-component-prop -- Read below when rendering JSON-LD.
	structuredData?: Record<string, unknown>;
};

const {
	locale,
	title,
	description,
	image = '/images/og.webp',
	imageAlt,
	isProfilePage = false,
	structuredData,
} = Astro.props;
const home = await getEntry('home', locale);

if (!home) {
	throw new Error(`Missing home content for locale "${locale}".`);
}

const routePath = Astro.url.pathname.replace(/^\/en(?=\/|$)/, '') || '/';
const getLocaleURL = (targetLocale: Locale) => {
	const path = routePath === '/' ? undefined : routePath;

	return new URL(getRelativeLocaleUrl(targetLocale, path), Astro.site);
};
const canonicalURL = getLocaleURL(locale);
const ogImageURL = new URL(image, Astro.site);
const sitemapURL = new URL('/sitemap-index.xml', Astro.site);
const siteURL = new URL('/', Astro.site);
const personURL = new URL('/', Astro.site);
personURL.hash = 'person';
const t = useTranslations(locale);
const resolvedImageAlt = imageAlt ?? t('meta.ogImageAlt');
const alternateLocale = locales.find((targetLocale) => targetLocale !== locale);
const alternateURL = alternateLocale ? getLocaleURL(alternateLocale) : undefined;
const personData = {
	'@type': 'Person',
	'@id': personURL,
	name: 'Mehdi Cheniki',
	url: siteURL,
	jobTitle: t('meta.jobTitle'),
	description: home.data.meta.description,
	image: new URL('/images/avatar-face.webp', Astro.site),
	knowsAbout: [
		'JavaScript',
		'PHP',
		'React',
		'WordPress',
		'TypeScript',
		'Laravel',
		'Web architecture',
		'CI/CD',
	],
	email: 'hello@mcheniki.dev',
	sameAs: ['https://www.linkedin.com/in/mehdi-cheniki/', 'https://github.com/mcheniki'],
};
const profilePageData = {
	'@type': 'ProfilePage',
	'@id': canonicalURL,
	url: canonicalURL,
	mainEntity: personData,
};
const websiteData = {
	'@type': 'WebSite',
	'@id': `${siteURL}#website`,
	name: 'Mehdi Cheniki',
	alternateName: 'mcheniki.dev',
	url: siteURL,
};
const profileData = isProfilePage
	? {
			'@context': 'https://schema.org',
			'@graph': [...(locale === 'fr' ? [websiteData] : []), profilePageData],
		}
	: {
			'@context': 'https://schema.org',
			...personData,
		};
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/ico" href="/favicon.ico" />
		<title>{title}</title>
		<link rel="canonical" href={canonicalURL} />
		{
			locales.map((targetLocale) => (
				<link
					rel="alternate"
					hreflang={localeMetadata[targetLocale].hreflang}
					href={getLocaleURL(targetLocale)}
				/>
			))
		}
		<link rel="alternate" hreflang="x-default" href={getLocaleURL('fr')} />
		<link rel="sitemap" href={sitemapURL} />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Mehdi Cheniki" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:alt" content={resolvedImageAlt} />
		<meta property="og:locale" content={localeMetadata[locale].openGraph} />
		{
			alternateLocale && (
				<meta
					property="og:locale:alternate"
					content={localeMetadata[alternateLocale].openGraph}
				/>
			)
		}

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />
		<meta name="twitter:image:alt" content={resolvedImageAlt} />

		<!-- JSON-LD -->
		<script is:inline type="application/ld+json" set:html={JSON.stringify(profileData)} />
		{
			structuredData && (
				<script
					is:inline
					type="application/ld+json"
					set:html={JSON.stringify(structuredData)}
				/>
			)
		}

		<link rel="preconnect" href="https://analytics.mcheniki.dev" />
		<script
			is:inline
			defer
			src="https://analytics.mcheniki.dev/script.js"
			data-website-id="2a60ab3c-52f7-40a1-b146-3fd9f55f9d90"></script>
	</head>
	<body class="bg-base-800 font-roundo text-base-50">
		<a
			href="#main-content"
			class="fixed top-6 left-6 z-[60] -translate-y-[calc(100%+1rem)] rounded-6 bg-base-0 px-12 py-6 font-jetbrains text-14 font-bold text-base-900 transition-transform focus:translate-y-0 focus-visible:outline-2 focus-visible:outline-offset-2 print:hidden"
		>
			{t('a11y.skipToContent')}
		</a>
		<Header locale={locale} alternateUrl={alternateURL?.pathname} />
		<slot />
		<Footer locale={locale} />
	</body>
</html>
