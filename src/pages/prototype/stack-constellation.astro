---
import { getEntry } from 'astro:content';
import About from '@components/About.astro';
import Contact from '@components/Contact.astro';
import Hero from '@components/Hero.astro';
import ProjectsSection from '@components/ProjectsSection.astro';
import StackConstellationSection from '@components/StackConstellationSection.astro';
import Layout from '../../layouts/Layout.astro';

export const prerender = false;

const locale = 'fr';
const home = await getEntry('home', locale);

if (!home) {
	throw new Error('Missing French home content.');
}

const content = home.data;
const variants = [
	'portal',
	'realistic',
	'outline',
	'gyroscope',
	'crescent',
	'gyroscope-portal',
] as const;
type Variant = (typeof variants)[number];
const requestedVariant = Astro.url.searchParams.get('variant');
const variant: Variant = variants.includes(requestedVariant as Variant)
	? (requestedVariant as Variant)
	: 'gyroscope';
---

<Layout
	locale={locale}
	title={`${content.meta.title} — Prototype constellation`}
	description={content.meta.description}
	noindex
	isProfilePage
>
	<main id="main-content" class="min-h-screen pt-128 lg:pt-48">
		<section class="mb-96 flex min-h-screen items-center">
			<Hero content={content.hero} />
		</section>
		<section class="mb-96 flex items-center">
			<About locale={locale} content={content.about} />
		</section>
		<section class="mb-96">
			<StackConstellationSection content={content.stack} variant={variant} />
		</section>
		<section class="mb-96 scroll-mt-128" id="projects">
			<ProjectsSection locale={locale} content={content.projects} />
		</section>
		<section class="mt-96 overflow-hidden" id="contact">
			<Contact locale={locale} content={content.contact} />
		</section>
	</main>
	{
		import.meta.env.DEV && (
			<nav class="prototype-variant-switcher" aria-label="Variante du prototype">
				<a
					aria-current={variant === 'portal' ? 'page' : undefined}
					href="?variant=portal#stack-constellation"
				>
					Portail
				</a>
				<a
					aria-current={variant === 'realistic' ? 'page' : undefined}
					href="?variant=realistic#stack-constellation"
				>
					Réaliste
				</a>
				<a
					aria-current={variant === 'outline' ? 'page' : undefined}
					href="?variant=outline#stack-constellation"
				>
					Ajourés
				</a>
				<a
					aria-current={variant === 'gyroscope' ? 'page' : undefined}
					href="?variant=gyroscope#stack-constellation"
				>
					Désaxés
				</a>
				<a
					aria-current={variant === 'crescent' ? 'page' : undefined}
					href="?variant=crescent#stack-constellation"
				>
					Décentrés
				</a>
				<a
					aria-current={variant === 'gyroscope-portal' ? 'page' : undefined}
					href="?variant=gyroscope-portal#stack-constellation"
				>
					Désaxés +
				</a>
			</nav>
		)
	}
</Layout>

<style>
	.prototype-variant-switcher {
		position: fixed;
		right: 1rem;
		bottom: 1rem;
		z-index: 30;
		display: flex;
		gap: 0.25rem;
		padding: 0.25rem;
		border: 1px solid color-mix(in srgb, var(--color-base-50) 30%, transparent);
		border-radius: 999px;
		background: color-mix(in srgb, var(--color-base-900) 88%, transparent);
		backdrop-filter: blur(10px);
		font-family: var(--font-jetbrains);
		font-size: 0.7rem;
		letter-spacing: 0.04em;
		max-width: calc(100vw - 2rem);
		flex-wrap: wrap;
		justify-content: flex-end;
	}

	.prototype-variant-switcher a {
		padding: 0.45rem 0.7rem;
		border-radius: 999px;
		color: var(--color-base-100);
		text-decoration: none;
	}

	.prototype-variant-switcher a[aria-current='page'] {
		background: var(--color-primary-500);
		color: var(--color-base-900);
	}

	@media (max-width: 42rem) {
		.prototype-variant-switcher {
			right: 0.5rem;
			bottom: 0.5rem;
			font-size: 0.625rem;
			max-width: calc(100vw - 1rem);
		}

		.prototype-variant-switcher a {
			padding: 0.4rem 0.55rem;
			white-space: nowrap;
		}
	}
</style>
