---
import Container from './Container.astro';
import { Portal } from './react/Portal/Portal';
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

type Props = {
	locale: Locale;
};

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Container customClass="flex flex-col items-center justify-between gap-32 lg:flex-row">
	<div class="flex-1 grow-0 lg:basis-[50%]">
		<h1
			class="mb-12 text-64 leading-[0.9] font-bold tracking-[-0.12em] uppercase italic md:text-clamp-h1"
		>
			<span class="block text-primary-500">{t('hero.jobPrimary')}</span>
			<span class="text-stroke-primary text-transparent">{t('hero.jobEmphasis')}</span>
		</h1>
		<p class="mb-24 text-25 leading-9 font-semibold">
			{t('hero.specialties')}
			<span class="block text-20 font-normal text-base-100">{t('hero.description')}</span>
		</p>
	</div>
	<div class="w-full max-w-[570px] flex-1 grow-0 lg:w-auto lg:basis-[570px]">
		<Portal client:visible />
	</div>
</Container>
