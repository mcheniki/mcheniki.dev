---
import Container from '@components/Container.astro';

import { Scene } from '@components/react/ThreeScene/Scene';

import ShapeH2 from '@svgs/shape-h2.svg';
import type { Locale } from '../i18n/config';
import { sceneMessages, useTranslations } from '../i18n/ui';

type Props = {
	locale: Locale;
};

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Container
	customClass="flex flex-col items-center justify-between gap-32 lg:gap-[10%] lg:flex-row-reverse bg-gradient-ten"
>
	<div class="max-lg:w-full lg:flex-1">
		<h2
			class="mb-12 flex items-center gap-6 text-14 font-medium tracking-[0.15em] text-primary-600 uppercase"
		>
			<ShapeH2 fill="currentColor" width="14" height="14" />
			{t('about.eyebrow')}
		</h2>
		<h3
			class="mb-24 text-48 leading-[1.3em] font-extralight tracking-tighter text-base-50 md:text-64"
		>
			<span class="mr-[10px] inline-block bg-primary-500 px-[10px]">
				{t('about.years')}
			</span>
			{t('about.title')}
		</h3>
		<p class="mb-12 font-medium">
			{t('about.paragraph1')}
		</p>
		<p class="mb-12 font-medium">
			{t('about.paragraph2')}
		</p>
		<p class="font-medium">
			{t('about.paragraph3')}
		</p>
	</div>
	<div class="max-lg:w-full max-lg:max-w-[464px] lg:flex-1">
		<div class="relative h-[530px] items-center justify-center lg:h-[80dvh]" data-active="true">
			<!-- Large "10" background text: tight letter-spacing (-60px) and indent (-38px) center the text visually -->
			<p
				class="text-stroke-primary absolute left-0 -z-[1] font-jetbrains text-clamp-ten font-bold -tracking-[60px] text-transparent xl:-indent-[38px]"
			>
				10
			</p>
			<div class="relative bg-no-repeat">
				<Scene client:visible locale={locale} messages={sceneMessages[locale]} />
			</div>
		</div>
	</div>
</Container>
