---
import { getIcon } from '@utils/icons';
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

type Props = {
	id: string;
	title: string;
	imageUrl: string;
	stack: string[];
	role?: string;
	locale: Locale;
};

const { id, title, imageUrl, stack, locale } = Astro.props;
const t = useTranslations(locale);
---

<div
	data-project-id={id}
	data-project-title={title}
	class="project-card group relative aspect-square h-full w-full overflow-hidden rounded-24 bg-base-0 text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 focus-visible:ring-offset-base-900"
	aria-label={t('projects.viewDetails', { title })}
>
	<img
		src={imageUrl}
		alt={t('projects.screenshot', { title })}
		width="600"
		height="600"
		loading="lazy"
		class="absolute inset-0 h-full w-full object-cover object-left transition-transform duration-300 group-hover:scale-105"
	/>
	<div class="absolute inset-0 bg-base-900/70 transition-colors group-hover:bg-base-900/60"></div>

	<div class="absolute inset-0 flex flex-col justify-between p-12">
		<h3
			class="absolute top-1/2 left-1/2 w-fit -translate-1/2 text-center font-jetbrains text-25 font-medium text-base-0"
		>
			{title}
		</h3>

		<ul class="flex flex-wrap gap-4 self-end">
			{
				stack.map((tech) => {
					const icon = getIcon(tech);

					return <li class="h-5 w-5 [&>svg]:fill-white" set:html={icon!.svg} />;
				})
			}
		</ul>
	</div>
	<button class="absolute inset-0 cursor-pointer"></button>
</div>
