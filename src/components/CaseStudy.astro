---
import { Image } from 'astro:assets';
import Container from '@components/Container.astro';
import Cta from '@components/Cta.astro';
import Layout from '../layouts/Layout.astro';
import type { Locale } from '../i18n/config';
import { getRoutePath } from '../i18n/routes';
import { getIcon, getIconTitle } from '../utils/icons';
import type { CaseStudy } from '../data/case-studies/types';

type Props = { locale: Locale; caseStudy: CaseStudy };
const { locale, caseStudy } = Astro.props;
const copy = caseStudy.content[locale];
const homeUrl = `${getRoutePath(locale, 'home')}#projects`;
const caseStudyUrl = new URL(Astro.url.pathname, Astro.site);
const heroImageUrl = new URL(caseStudy.hero.image.src, Astro.site);
const personUrl = new URL('/', Astro.site);
personUrl.hash = 'person';
const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebPage',
			'@id': `${caseStudyUrl}#webpage`,
			url: caseStudyUrl,
			name: copy.metaTitle,
			description: copy.metaDescription,
			inLanguage: locale,
			primaryImageOfPage: heroImageUrl,
			mainEntity: { '@id': caseStudy.softwareId },
		},
		{
			'@type': 'SoftwareApplication',
			'@id': caseStudy.softwareId,
			name: copy.title,
			url: caseStudy.applicationUrl,
			description: copy.intro,
			applicationCategory: caseStudy.applicationCategory,
			operatingSystem: 'Web',
			isAccessibleForFree: true,
			author: { '@id': personUrl },
			image: heroImageUrl,
		},
	],
};
---

<Layout
	locale={locale}
	route={caseStudy.route}
	title={copy.metaTitle}
	description={copy.metaDescription}
	image={caseStudy.hero.image.src}
	imageAlt={copy.heroAlt}
	structuredData={structuredData}
>
	<main id="main-content" class="pt-160 pb-96">
		<Container>
			<a
				href={homeUrl}
				class="mb-32 inline-flex items-center gap-6 font-jetbrains text-14 text-base-200 transition-colors hover:text-primary-400"
			>
				<span aria-hidden="true">←</span>
				{copy.back}
			</a>
			<header class="mb-64">
				<div class="mb-24 flex flex-wrap gap-6">
					{
						[copy.label, copy.role, copy.year].map((item) => (
							<span class="rounded-full border border-base-500 px-12 py-6 text-14 text-base-100">
								{item}
							</span>
						))
					}
				</div>
				<div class="grid items-end gap-32 lg:grid-cols-[1fr_auto]">
					<div>
						<h1
							class="mb-12 text-64 leading-none font-medium tracking-tighter text-base-0 md:text-96"
						>
							{copy.title}
						</h1>
						<p class="max-w-3xl text-20 leading-relaxed text-base-100">
							{copy.intro}
						</p>
						<ul class="mt-24 flex flex-wrap gap-6" aria-label={copy.stackEyebrow}>
							{
								caseStudy.stack
									.slice(0, 4)
									.map((tech) => (
										<li class="rounded-full bg-base-700 px-12 py-6 text-14 text-base-100">
											{getIconTitle(tech)}
										</li>
									))
							}
						</ul>
					</div>
					<Cta url={caseStudy.applicationUrl} target="_blank" rel="noopener noreferrer">
						{copy.open}
						<span aria-hidden="true">↗</span>
					</Cta>
				</div>
			</header>
			<figure class="mb-96">
				<Image
					src={caseStudy.hero.image}
					alt={copy.heroAlt}
					width={caseStudy.hero.width}
					height={caseStudy.hero.height}
					class="h-auto w-full rounded-24 border border-base-600"
				/>
				{
					copy.heroCaption && (
						<figcaption class="mt-12 max-w-4xl text-14 leading-relaxed text-base-300">
							{copy.heroCaption}
						</figcaption>
					)
				}
			</figure>
			<section class="mb-96 grid gap-48 lg:grid-cols-2">
				<div>
					<h2 class="mb-6 text-14 font-medium tracking-wider text-primary-500 uppercase">
						{copy.problemEyebrow}
					</h2>
					<h3 class="mb-12 font-jetbrains text-36 leading-tight text-base-0">
						{copy.problemTitle}
					</h3>
					<p class="text-16 leading-relaxed text-base-100">{copy.problem}</p>
				</div>
				<div>
					<div class="rounded-24 bg-base-700 p-24">
						<h3 class="mb-12 font-jetbrains text-20 text-base-0">
							{copy.challengesTitle}
						</h3>
						<ul
							class="text-16 list-disc space-y-6 pl-24 leading-relaxed text-base-100 marker:text-primary-500"
						>
							{copy.challenges.map((item) => <li>{item}</li>)}
						</ul>
					</div>
				</div>
			</section>
			<section class="mb-96">
				<header class="mb-32 max-w-3xl">
					<h2 class="mb-6 text-14 font-medium tracking-wider text-primary-500 uppercase">
						{copy.decisionsEyebrow}
					</h2>
					<h3 class="font-jetbrains text-36 leading-tight text-base-0">
						{copy.decisionsTitle}
					</h3>
				</header>
				<div class="grid gap-24 lg:grid-cols-3">
					{
						copy.decisions.map((decision, index) => (
							<article class="rounded-24 border border-base-600 p-24">
								<p class="mb-24 font-jetbrains text-14 text-primary-500">
									0{index + 1}
								</p>
								<h4 class="mb-12 font-jetbrains text-20 text-base-0">
									{decision.title}
								</h4>
								<p class="text-16 leading-relaxed text-base-100">{decision.text}</p>
							</article>
						))
					}
				</div>
			</section>
			<section class="mb-96 grid gap-48">
				<h2 class="text-14 font-medium tracking-wider text-primary-500 uppercase">
					{copy.imagesEyebrow}
				</h2>
				{
					caseStudy.gallery.map((item) => (
						<figure>
							<Image
								src={item.image}
								alt={item.alt[locale]}
								width={item.width}
								height={item.height}
								widths={item.widths}
								sizes={item.sizes}
								quality={item.quality}
								loading="lazy"
								class="w-full rounded-24 border border-base-600"
							/>
							<figcaption class="mt-12 max-w-4xl text-14 leading-relaxed text-base-300">
								{item.caption[locale]}
							</figcaption>
						</figure>
					))
				}
			</section>
			<section class="mb-96 rounded-24 bg-base-700 p-24 md:p-48">
				<h2 class="mb-6 text-14 font-medium tracking-wider text-primary-500 uppercase">
					{copy.stackEyebrow}
				</h2>
				<h3 class="mb-24 max-w-4xl font-jetbrains text-36 leading-tight text-base-0">
					{copy.stackTitle}
				</h3>
				<ul class="mb-24 flex flex-wrap gap-12">
					{
						caseStudy.stack.map((tech) => {
							const icon = getIcon(tech);
							return (
								<li class="flex items-center gap-6 rounded-full bg-base-800 px-12 py-6">
									{icon && (
										<span
											class="h-5 w-5 [&>svg]:fill-white"
											set:html={icon.svg}
										/>
									)}
									<span class="text-14 text-base-100">{getIconTitle(tech)}</span>
								</li>
							);
						})
					}
				</ul>
				<p class="text-14 leading-relaxed text-base-300">{copy.stackDetails}</p>
			</section>
			<section class="rounded-24 border border-primary-500/50 p-24 text-center md:p-64">
				<h2 class="mb-6 text-14 font-medium tracking-wider text-primary-500 uppercase">
					{copy.finalEyebrow}
				</h2>
				<h3 class="mb-12 font-jetbrains text-36 text-base-0">{copy.finalTitle}</h3>
				<p class="text-16 mx-auto mb-24 max-w-2xl leading-relaxed text-base-100">
					{copy.finalText}
				</p>
				<div class="flex justify-center">
					<Cta url={caseStudy.applicationUrl} target="_blank" rel="noopener noreferrer">
						{copy.open}
						<span aria-hidden="true">↗</span>
					</Cta>
				</div>
			</section>
		</Container>
	</main>
</Layout>
