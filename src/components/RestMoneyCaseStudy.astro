---
import { Image } from 'astro:assets';
import Container from '@components/Container.astro';
import Cta from '@components/Cta.astro';
import Layout from '../layouts/Layout.astro';
import type { Locale } from '../i18n/config';
import { getIcon, getIconTitle } from '../utils/icons';
import heroImage from '../content/projects/restmoney/restmoney.webp';
import dashboardImage from '../content/projects/restmoney/restmoney-dashboard.webp';
import incomeImage from '../content/projects/restmoney/restmoney-income.webp';

type Props = {
	locale: Locale;
};

const { locale } = Astro.props;
const applicationUrl = 'https://restmoney.mcheniki.dev/';
const stack = ['react', 'typescript', 'tanstack', 'tailwindcss', 'sqlite'];

const content = {
	fr: {
		metaTitle: 'RestMoney | Projet full-stack de Mehdi Cheniki',
		metaDescription:
			'Une application personnelle pour suivre ses revenus d’auto-entrepreneur et voir ce qu’il reste après les cotisations et les impôts.',
		back: 'Retour aux projets',
		label: 'Projet personnel',
		role: 'Développement full-stack',
		year: '2026',
		title: 'RestMoney',
		intro: 'Un outil personnel pour suivre mes encaissements et estimer ce qu’il me reste après les cotisations et les impôts, au fil de l’année.',
		open: "Ouvrir l'application",
		heroAlt: 'Montage de présentation de RestMoney montrant un aperçu du tableau de bord',
		heroCaption: 'Montage de présentation réalisé à partir de l’interface de RestMoney.',
		problemTitle: 'Savoir ce qu’il me reste, au fil de l’année',
		problem:
			'En tant qu’auto-entrepreneur, je voulais savoir, à chaque encaissement, ce que je pouvais vraiment considérer comme disponible. Le chiffre d’affaires seul ne suffit pas : RestMoney affiche les montants à mettre de côté pour les cotisations et les impôts, puis estime ce qu’il me reste. C’est un repère pour suivre mon année, pas un outil de conseil comptable.',
		builtTitle: "Ce que j'ai construit",
		built: [
			'Un tableau de bord annuel qui relie revenus, cotisations et montant restant.',
			'L’ajout, la modification, la suppression, la recherche, le tri et l’historique des revenus.',
			'Le réglage du taux URSSAF afin d’adapter les calculs à ma situation.',
			'Une démo invitée avec des données fictives, séparées de mes données personnelles.',
		],
		roleTitle: 'Mon rôle',
		roleText:
			'J’ai imaginé puis développé RestMoney, des calculs visibles dans l’interface jusqu’à l’architecture full-stack, l’authentification, les données de démonstration et la mise en ligne.',
		decisionsTitle: 'Des choix techniques adaptés à un outil personnel',
		decisions: [
			{
				title: 'Une application full-stack TypeScript',
				text: 'TanStack Start réunit le rendu côté serveur, le routage et les fonctions serveur dans un même projet React. Le typage suit les données d’un bout à l’autre, sans API REST séparée à maintenir.',
			},
			{
				title: 'Des données isolées par compte',
				text: 'Better Auth gère les comptes et les sessions. Les revenus et réglages de chaque personne sont enregistrés dans leur propre fichier SQLite : les données personnelles restent ainsi séparées de celles de la démo.',
			},
			{
				title: 'Des opérations protégées et validées',
				text: 'Les changements de revenus et de réglages passent par des fonctions serveur authentifiées. Les données sont vérifiées avant l’enregistrement pour garder des calculs cohérents.',
			},
		],
		dashboardAlt:
			'Synthèse annuelle des revenus et provisions dans le tableau de bord RestMoney',
		dashboardCaption:
			'Le tableau de bord rapproche le chiffre d’affaires encaissé, les sommes à mettre de côté et le montant restant.',
		incomeAlt: 'Liste et historique des revenus enregistrés dans RestMoney',
		incomeCaption:
			'Les revenus peuvent être recherchés, triés et consultés pour comprendre leur effet sur le montant restant.',
		stackTitle: 'Une base full-stack pensée pour rester simple',
		stackDetails: 'TanStack Start · Better Auth · Drizzle ORM · Bun · Zod · Recharts · Vite',
		finalTitle: 'Découvrir RestMoney',
		finalText:
			'L’application est disponible en démo avec des données fictives. Les montants affichés sont des estimations et ne remplacent pas un conseil fiscal ou comptable.',
	},
	en: {
		metaTitle: 'RestMoney | Full-stack project by Mehdi Cheniki',
		metaDescription:
			'A personal application for tracking freelance income and seeing what remains after contributions and taxes are set aside.',
		back: 'Back to projects',
		label: 'Personal project',
		role: 'Full-stack development',
		year: '2026',
		title: 'RestMoney',
		intro: 'A personal tool for tracking my income and estimating what remains after contributions and taxes throughout the year.',
		open: 'Open the application',
		heroAlt: 'RestMoney presentation montage showing an overview of the dashboard',
		heroCaption: 'Presentation montage created from the RestMoney interface.',
		problemTitle: 'Knowing what remains throughout the year',
		problem:
			'As a self-employed professional, I wanted to know, with each payment, what I could actually treat as available. Revenue alone does not answer that: RestMoney shows the amounts to set aside for contributions and taxes, then estimates what remains. It is a practical way to follow my year, not accounting advice.',
		builtTitle: 'What I built',
		built: [
			'An annual dashboard connecting income, contributions and the remaining amount.',
			'Income creation, editing, deletion, search, sorting and history.',
			'URSSAF rate settings to adapt calculations to my situation.',
			'A guest demo with fictional data, kept separate from my personal data.',
		],
		roleTitle: 'My role',
		roleText:
			'I shaped and developed RestMoney, from the calculations shown in the interface through to the full-stack architecture, authentication, demonstration data and deployment.',
		decisionsTitle: 'Technical choices suited to a personal tool',
		decisions: [
			{
				title: 'A full-stack TypeScript application',
				text: 'TanStack Start brings server-side rendering, routing and server functions together in one React project. Data stays typed end to end, with no separate REST API to maintain.',
			},
			{
				title: 'Data isolated by account',
				text: 'Better Auth manages accounts and sessions. Each person’s income and settings are stored in their own SQLite file, keeping personal data separate from the demo.',
			},
			{
				title: 'Protected, validated operations',
				text: 'Income and settings changes go through authenticated server functions. Data is checked before it is saved, keeping calculations consistent.',
			},
		],
		dashboardAlt: 'Annual overview of income and provisions on the RestMoney dashboard',
		dashboardCaption:
			'The dashboard brings together collected revenue, the amounts to set aside and what remains.',
		incomeAlt: 'List and history of income entries recorded in RestMoney',
		incomeCaption:
			'Income can be searched, sorted and inspected to understand its effect on what remains.',
		stackTitle: 'A full-stack foundation designed to stay simple',
		stackDetails: 'TanStack Start · Better Auth · Drizzle ORM · Bun · Zod · Recharts · Vite',
		finalTitle: 'Explore RestMoney',
		finalText:
			'The application is available as a demo with fictional data. Displayed amounts are estimates and do not replace tax or accounting advice.',
	},
} as const;

const copy = content[locale];
const homeUrl = locale === 'fr' ? '/#projects' : '/en/#projects';
const caseStudyUrl = new URL(
	locale === 'fr' ? '/projects/restmoney/' : '/en/projects/restmoney/',
	Astro.site,
);
const heroImageUrl = new URL(heroImage.src, Astro.site);
const personUrl = new URL('/', Astro.site);
personUrl.hash = 'person';
const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebPage',
			'@id': `${caseStudyUrl}#webpage`,
			url: caseStudyUrl,
			name: copy.metaTitle,
			description: copy.metaDescription,
			inLanguage: locale,
			primaryImageOfPage: heroImageUrl,
			mainEntity: { '@id': `${applicationUrl}#software` },
		},
		{
			'@type': 'SoftwareApplication',
			'@id': `${applicationUrl}#software`,
			name: copy.title,
			url: applicationUrl,
			description: copy.intro,
			applicationCategory: 'FinanceApplication',
			operatingSystem: 'Web',
			isAccessibleForFree: true,
			author: { '@id': personUrl },
			image: heroImageUrl,
		},
	],
};
---

<Layout
	locale={locale}
	title={copy.metaTitle}
	description={copy.metaDescription}
	image={heroImage.src}
	imageAlt={copy.heroAlt}
	structuredData={structuredData}
>
	<main id="main-content" class="pt-160 pb-96">
		<Container>
			<a
				href={homeUrl}
				class="mb-32 inline-flex items-center gap-6 font-jetbrains text-14 text-base-200 transition-colors hover:text-primary-400"
			>
				<span aria-hidden="true">←</span>
				{copy.back}
			</a>

			<header class="mb-64">
				<div class="mb-24 flex flex-wrap gap-6">
					{
						[copy.label, copy.role, copy.year].map((item) => (
							<span class="rounded-full border border-base-500 px-12 py-6 text-14 text-base-100">
								{item}
							</span>
						))
					}
				</div>
				<div class="grid items-end gap-32 lg:grid-cols-[1fr_auto]">
					<div>
						<h1
							class="mb-12 text-64 leading-none font-medium tracking-tighter text-base-0 md:text-96"
						>
							{copy.title}
						</h1>
						<p class="max-w-3xl text-20 leading-relaxed text-base-100">{copy.intro}</p>
						<ul class="mt-24 flex flex-wrap gap-6" aria-label={copy.stackTitle}>
							{
								stack
									.slice(0, 4)
									.map((tech) => (
										<li class="rounded-full bg-base-700 px-12 py-6 text-14 text-base-100">
											{getIconTitle(tech)}
										</li>
									))
							}
						</ul>
					</div>
					<Cta url={applicationUrl} target="_blank" rel="noopener noreferrer">
						{copy.open}
						<span aria-hidden="true">↗</span>
					</Cta>
				</div>
			</header>

			<figure class="mb-96">
				<Image
					src={heroImage}
					alt={copy.heroAlt}
					width={1280}
					height={853}
					class="h-auto w-full rounded-24 border border-base-600"
				/>
				<figcaption class="mt-12 max-w-4xl text-14 leading-relaxed text-base-300">
					{copy.heroCaption}
				</figcaption>
			</figure>

			<section class="mb-96 grid gap-48 lg:grid-cols-2">
				<div>
					<h2 class="mb-12 font-jetbrains text-36 leading-tight text-base-0">
						{copy.problemTitle}
					</h2>
					<p class="text-16 leading-relaxed text-base-100">{copy.problem}</p>
				</div>
				<div class="grid gap-24 sm:grid-cols-2">
					<div class="rounded-24 bg-base-700 p-24">
						<h2 class="mb-12 font-jetbrains text-20 text-base-0">{copy.builtTitle}</h2>
						<ul
							class="text-16 list-disc space-y-6 pl-24 leading-relaxed text-base-100 marker:text-primary-500"
						>
							{copy.built.map((item) => <li>{item}</li>)}
						</ul>
					</div>
					<div class="rounded-24 border border-base-600 p-24">
						<h2 class="mb-12 font-jetbrains text-20 text-base-0">{copy.roleTitle}</h2>
						<p class="text-16 leading-relaxed text-base-100">{copy.roleText}</p>
					</div>
				</div>
			</section>

			<section class="mb-96">
				<header class="mb-32 max-w-3xl">
					<h2 class="font-jetbrains text-36 leading-tight text-base-0">
						{copy.decisionsTitle}
					</h2>
				</header>
				<div class="grid gap-24 lg:grid-cols-3">
					{
						copy.decisions.map((decision) => (
							<article class="rounded-24 border border-base-600 p-24">
								<h3 class="mb-12 font-jetbrains text-20 text-base-0">
									{decision.title}
								</h3>
								<p class="text-16 leading-relaxed text-base-100">{decision.text}</p>
							</article>
						))
					}
				</div>
			</section>

			<section class="mb-96 grid gap-48">
				<figure>
					<Image
						src={dashboardImage}
						alt={copy.dashboardAlt}
						widths={[640, 1280, 2560]}
						sizes="(min-width: 1280px) 1230px, calc(100vw - 48px)"
						quality={100}
						loading="lazy"
						class="w-full rounded-24 border border-base-600"
					/>
					<figcaption class="mt-12 max-w-4xl text-14 leading-relaxed text-base-300">
						{copy.dashboardCaption}
					</figcaption>
				</figure>
				<figure>
					<Image
						src={incomeImage}
						alt={copy.incomeAlt}
						widths={[640, 1280, 2560]}
						sizes="(min-width: 1280px) 1230px, calc(100vw - 48px)"
						quality={100}
						loading="lazy"
						class="w-full rounded-24 border border-base-600"
					/>
					<figcaption class="mt-12 max-w-4xl text-14 leading-relaxed text-base-300">
						{copy.incomeCaption}
					</figcaption>
				</figure>
			</section>

			<section class="mb-96 rounded-24 bg-base-700 p-24 md:p-48">
				<h2 class="mb-24 max-w-4xl font-jetbrains text-36 leading-tight text-base-0">
					{copy.stackTitle}
				</h2>
				<ul class="mb-24 flex flex-wrap gap-12">
					{
						stack.map((tech) => {
							const icon = getIcon(tech);
							return (
								<li class="flex items-center gap-6 rounded-full bg-base-800 px-12 py-6">
									{icon && (
										<span
											class="h-5 w-5 [&>svg]:fill-white"
											set:html={icon.svg}
										/>
									)}
									<span class="text-14 text-base-100">{getIconTitle(tech)}</span>
								</li>
							);
						})
					}
				</ul>
				<p class="text-14 leading-relaxed text-base-300">{copy.stackDetails}</p>
			</section>

			<section class="rounded-24 border border-primary-500/50 p-24 text-center md:p-64">
				<h2 class="mb-12 font-jetbrains text-36 text-base-0">{copy.finalTitle}</h2>
				<p class="text-16 mx-auto mb-24 max-w-2xl leading-relaxed text-base-100">
					{copy.finalText}
				</p>
				<div class="flex justify-center">
					<Cta url={applicationUrl} target="_blank" rel="noopener noreferrer">
						{copy.open}
						<span aria-hidden="true">↗</span>
					</Cta>
				</div>
			</section>
		</Container>
	</main>
</Layout>
