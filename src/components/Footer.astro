---
import Container from '@components/Container.astro';
import IconGithub from '@svgs/github.svg';
import IconMail from '@svgs/mail.svg';
import IconLinkedin from '@svgs/linkedin.svg';
import IconStar from '@svgs/star.svg';
import { Image } from 'astro:assets';
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

type Props = {
	locale: Locale;
};

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<footer class="lg:mt-96">
	<Container customClass="relative">
		<!-- Avatar positioned to overlap footer edge: 190px aligns with container padding, 69% creates peek effect -->
		<Image
			src="/images/footer-avatar.webp"
			alt={t('footer.avatarAlt')}
			width="166"
			height="230"
			class="absolute top-0 left-0 translate-x-[190px] -translate-y-[69%] max-lg:hidden"
		/>
		<div
			class="flex flex-col items-center justify-between gap-48 rounded-32 bg-base-600 px-64 py-24 text-base-600 md:flex-row"
		>
			<ul class="flex gap-24">
				<li>
					<a href="mailto:hello@mcheniki.dev" class="text-base-50">
						<IconMail width="20" height="20" fill="currentColor" />
						<span class="sr-only">{t('footer.email')}</span>
					</a>
				</li>
				<li>
					<a
						href="https://www.linkedin.com/in/mehdi-cheniki/"
						class="text-base-50"
						target="_blank"
						rel="noreferrer noopener"
					>
						<IconLinkedin width="20" height="20" fill="currentColor" />
						<span class="sr-only">{t('footer.linkedin')}</span>
					</a>
				</li>
				<li>
					<a
						href="https://github.com/mcheniki"
						class="text-base-50"
						target="_blank"
						rel="noreferrer noopener"
					>
						<IconGithub width="20" height="20" fill="currentColor" />
						<span class="sr-only">{t('footer.github')}</span>
					</a>
				</li>
			</ul>
			<p class="text-center text-primary-500">
				Mehdi Cheniki
				<br />
				<span class="text-12 text-base-200">{t('footer.copyright')}</span>
			</p>
			<div class="max-md:hidden"></div>
		</div>
		<p
			class="flex items-center justify-center gap-6 py-24 text-12 text-base-100 max-md:flex-col"
		>
			{t('footer.developedBy')}
			<span>Mehdi Cheniki</span>
			<IconStar width="12" height="12" fill="currentColor" />
			{t('footer.designedBy')}
			<a
				href="https://elkhantour.com"
				target="_blank"
				class="underline"
				rel="noreferrer noopener"
			>
				Nassim El Khantour
			</a>
		</p>
	</Container>
</footer>
