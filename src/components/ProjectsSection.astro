---
import { getCollection, render } from 'astro:content';
import Container from '@components/Container.astro';
import ProjectCard from '@components/ProjectCard.astro';
import ProjectDrawer from '@components/ProjectDrawer.astro';
import ProjectDrawerContent from '@components/ProjectDrawerContent.astro';
import ShapeH2 from '@svgs/shape-h2.svg';
import { validateProjectTranslations } from '../content/projects';
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

type Props = {
	locale: Locale;
};

const { locale } = Astro.props;
const t = useTranslations(locale);

const projects = await getCollection('projects');
validateProjectTranslations(projects);

const sortedProjects = projects
	.filter((project) => project.data.locale === locale)
	.sort((a, b) => {
		const orderA = a.data.order ?? Infinity;
		const orderB = b.data.order ?? Infinity;
		if (orderA !== orderB) return orderA - orderB;
		return a.data.title.localeCompare(b.data.title);
	});

const renderedProjects = await Promise.all(
	sortedProjects.map(async (project) => {
		const { Content } = await render(project);
		return { project, Content };
	}),
);

const professionalProjects = sortedProjects.filter(
	(project) => project.data.projectType === 'professional',
);
const personalProjects = sortedProjects.filter(
	(project) => project.data.projectType === 'personal',
);
const ecokwaCaseStudyUrl = locale === 'fr' ? '/projects/ecokwa/' : '/en/projects/ecokwa/';
---

<Container>
	<header class="mb-48 text-center">
		<h2
			class="mb-12 flex items-center justify-center gap-6 text-14 font-medium tracking-[0.15em] text-primary-600 uppercase"
		>
			<ShapeH2 fill="currentColor" width="14" height="14" />
			{t('projects.eyebrow')}
		</h2>
		<h3 class="text-64 leading-[1.3em] font-extralight tracking-tighter text-base-50">
			{t('projects.title')}
		</h3>
	</header>

	<div class="flex flex-col gap-64">
		<section aria-labelledby="professional-projects-title">
			<header class="mb-24 max-w-3xl">
				<h4 id="professional-projects-title" class="mb-6 text-36 font-light text-base-0">
					{t('projects.professionalTitle')}
				</h4>
				<p class="text-16 leading-relaxed text-base-300">
					{t('projects.professionalDescription')}
				</p>
			</header>
			<div class="grid gap-24 md:grid-cols-2 lg:grid-cols-3">
				{
					professionalProjects.map((project) => (
						<ProjectCard
							id={project.data.translationKey}
							title={project.data.title}
							imageUrl={project.data.image.src}
							stack={project.data.stack}
							locale={locale}
						/>
					))
				}
			</div>
		</section>

		{
			personalProjects.length > 0 && (
				<section aria-labelledby="personal-projects-title" data-project-group="personal">
					<header class="mb-24 max-w-3xl">
						<h4
							id="personal-projects-title"
							class="mb-6 text-36 font-light text-base-0"
						>
							{t('projects.personalTitle')}
						</h4>
						<p class="text-16 leading-relaxed text-base-300">
							{t('projects.personalDescription')}
						</p>
					</header>
					<div class="grid gap-24 md:grid-cols-2 lg:grid-cols-3">
						{personalProjects.map((project) => (
							<ProjectCard
								id={project.data.translationKey}
								title={project.data.title}
								imageUrl={project.data.image.src}
								stack={project.data.stack}
								locale={locale}
							/>
						))}
					</div>
				</section>
			)
		}
	</div>

	{/* Pre-rendered templates for each project's drawer content */}
	{
		renderedProjects.map(({ project, Content }) => (
			<template data-project-id={project.data.translationKey}>
				<ProjectDrawerContent
					stack={project.data.stack}
					mission={project.data.mission}
					url={project.data.url}
					caseStudyUrl={
						project.data.translationKey === 'ecokwa' ? ecokwaCaseStudyUrl : undefined
					}
					locale={locale}
				>
					<Content />
				</ProjectDrawerContent>
			</template>
		))
	}

	<ProjectDrawer locale={locale} />
</Container>
