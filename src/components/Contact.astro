---
import Container from '@components/Container.astro';
import { ErrorBoundary } from '@components/react/error-boundary';
import { Form } from '@components/react/Form';

import IconMail from '@svgs/mail.svg';
import ShapeH2 from '@svgs/shape-h2.svg';
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

type Props = {
	locale: Locale;
};

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Container customClass="mt-64">
	<header class="mb-64 text-center">
		<h2
			class="flex -translate-x-[14px] items-center justify-center gap-6 text-14 font-medium tracking-[0.15em] text-primary-600 uppercase"
		>
			<ShapeH2 fill="currentColor" width="14" height="14" />
			{t('contact.eyebrow')}
		</h2>
		<h3
			class="-tracking-tighter] mb-24 text-48 leading-[1.3em] font-extralight tracking-tighter text-base-50 md:text-64"
		>
			{t('contact.title')}
		</h3>
		<p class="mb-32">
			{t('contact.description')}
		</p>
		<div class="flex justify-between gap-24">
			<address class="basis-1/3 max-md:hidden">
				<h4 class="mb-32 text-left text-25 tracking-[0.025em] text-base-50 not-italic">
					{t('contact.details')}
				</h4>
				<a href="mailto:hello@mcheniki.dev" class="mb-12 flex items-center gap-6">
					<IconMail width="20" height="16" fill="currentColor" />
					hello@mcheniki.dev
				</a>
			</address>
			<div class="basis-full md:basis-2/3">
				<ErrorBoundary client:only>
					<Form client:only />
				</ErrorBoundary>
			</div>
		</div>
	</header>
</Container>
