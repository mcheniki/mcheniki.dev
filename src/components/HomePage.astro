---
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import Layout from '../layouts/Layout.astro';
import Hero from './Hero.astro';
import About from './About.astro';
import StackSection from './StackSection.astro';
import ProjectsSection from './ProjectsSection.astro';
import Contact from './Contact.astro';

type Props = {
	locale: Locale;
};

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Layout locale={locale} title={t('meta.title')} description={t('meta.description')} isProfilePage>
	<main class="min-h-screen pt-128 lg:pt-48">
		<section class="mb-96 flex min-h-screen items-center">
			<Hero locale={locale} />
		</section>
		<section class="mb-96 flex items-center">
			<About locale={locale} />
		</section>
		<section class="mb-96">
			<StackSection locale={locale} />
		</section>
		<section class="mb-96 scroll-mt-128" id="projects">
			<ProjectsSection locale={locale} />
		</section>
		<section class="mt-96 overflow-hidden" id="contact">
			<Contact locale={locale} />
		</section>
	</main>
</Layout>
