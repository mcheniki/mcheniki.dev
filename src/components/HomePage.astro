---
import type { Locale } from '../i18n/config';
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from './Hero.astro';
import About from './About.astro';
import StackSection from './StackSection.astro';
import ProjectsSection from './ProjectsSection.astro';
import Contact from './Contact.astro';

type Props = {
	locale: Locale;
};

const { locale } = Astro.props;
const home = await getEntry('home', locale);

if (!home) {
	throw new Error(`Missing home content for locale "${locale}".`);
}

const content = home.data;
---

<Layout
	locale={locale}
	title={content.meta.title}
	description={content.meta.description}
	isProfilePage
>
	<main id="main-content" class="min-h-screen pt-128 lg:pt-48">
		<section class="mb-96 flex min-h-screen items-center">
			<Hero content={content.hero} />
		</section>
		<section class="mb-96 flex items-center">
			<About locale={locale} content={content.about} />
		</section>
		<section class="mb-96">
			<StackSection content={content.stack} />
		</section>
		<section class="mb-96 scroll-mt-128" id="projects">
			<ProjectsSection locale={locale} content={content.projects} />
		</section>
		<section class="mt-96 overflow-hidden" id="contact">
			<Contact locale={locale} content={content.contact} />
		</section>
	</main>
</Layout>
